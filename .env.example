# 推送目标（必填）
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# 审核通道：github-models | gemini | deepseek | openai
REVIEW_PROVIDER=github-models
REVIEW_MODEL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 筛选策略
MIN_SCORE=6
MAX_PER_SOURCE=12
MAX_CANDIDATES=400
INTEREST_PROFILE=

# 收集阶段
COLLECT_WINDOW_HOURS=3

# 被 Cloudflare 拦住时的兜底
ENABLE_JINA_FALLBACK=0
PROXY_PREFIX=

DRY_RUN=0
